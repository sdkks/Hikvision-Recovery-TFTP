<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Hikvision_Recovery_TFTP</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Version>1.0.0.0</Version>
		<Authors>Den34DK</Authors>
		<Company>Den34DK</Company>
		<Product>Hikvision-Recovery-TFTP</Product>
		<Description>Hikvision Custom TFTP Server for Large Files</Description>
		<ApplicationIcon>cam.ico</ApplicationIcon>
		<AssemblyName>Hikvision-Recovery-TFTP</AssemblyName>
		<Title>Hikvision-Recovery-TFTP</Title>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="cam.ico" />
	</ItemGroup>

</Project>
